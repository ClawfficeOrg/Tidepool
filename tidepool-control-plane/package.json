{
  "name": "@clawffice/tidepool-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Tidepool control plane: a Svelte, Vite and TypeScript app over the Tidepool hub, styled by clawffice-design tokens",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "design:snapshot": "node src/lib/design/snapshot.mjs",
    "design:check": "node src/lib/design/snapshot.mjs --check"
  },
  "dependencies": {
    "@clawffice/tidepool-sdk": "file:../sdk/ts",
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.1.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
