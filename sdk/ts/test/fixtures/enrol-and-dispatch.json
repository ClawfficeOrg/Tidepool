{
  "name": "fresh install enrols a host and dispatches a run",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/hosts/enrollment-tokens",
        "body": { "host_id": "host_01" }
      },
      "response": {
        "status": 201,
        "body": {
          "token": "enr_7c1f",
          "enrollment_token": {
            "id": "etk_01",
            "created_at": "2026-10-29T05:00:00Z",
            "expires_at": "2026-10-29T05:15:00Z",
            "consumed_at": null,
            "revoked_at": null
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/hosts/enroll",
        "body": { "token": "enr_7c1f", "credential": "host-secret" }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "host_01",
          "slug": "build-box",
          "display_name": "Build box",
