{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.d.ts", "test/generated/conformance.ts"]
}
