# Caddy site block for a Tidepool pool.
#
# Install as /etc/caddy/sites/pool.conf (or append to /etc/caddy/Caddyfile) on
# the VPS and let Caddy issue and renew the certificate. The upstream is the
# pool's container name on the shared proxy network, or 127.0.0.1:8080 when
# running the loopback binding.
#
# Replace pool.example.com with the documented hostname and make sure the DNS
# A/AAAA record already points at the VPS before reloading Caddy.

pool.example.com {
	encode zstd gzip
	request_body {
		max_size 2MB
	}

	# Websockets: the chatroom stream and the game/host sockets.
	@ws {
		path /v1/chatrooms/* /ws*
	}
	reverse_proxy @ws 127.0.0.1:8080 {
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /var/log/caddy/pool.log
		format json
	}
}
