# Tidepool Server — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
#
# SECURITY: generate a fresh JWT_SECRET per environment, e.g.
#   openssl rand -hex 32
# Never reuse a secret that has ever been committed to git — a committed value
# is compromised even after it is removed from history. `openssl rand -hex 64`
# is the strongest option given HS256's 64-byte block size.

# Server
# Inside the compose stack HOST is set to 0.0.0.0; run it locally on loopback.
HOST=127.0.0.1
PORT=8080

# Public origin (single setting for a deployment's address)
# Scheme + host + optional port, no path. Changing it changes the webhook URLs
# handed to providers, so update them in the same move. See
# docs/SELF_HOSTING.md for the full consequences.
# TIDEPOOL_PUBLIC_ORIGIN=https://pool.example.com

# Database
DATABASE_URL=mysql://tidepool:password@localhost:3306/tidepool_dev

# JWT
JWT_SECRET=changeme_at_least_32_characters_long
JWT_EXPIRY_SECONDS=3600

# Redis
# Default dev-stack Redis. If host port 6379 is taken by another service,
# use config/docker-compose.dev.override.yml (redis on 6380) and set:
#   REDIS_URL=redis://localhost:6380
REDIS_URL=redis://localhost:6379

# Provider connections (optional)
# JSON array of complete connection definitions. These take precedence over
# database rows with the same slug and are labelled managed_by=environment.
# Credentials live in referenced environment variables as JSON objects, never
# in this list.
# TIDEPOOL_CONNECTIONS=[]
# GITHUB_ACME_CREDS={"app_id":"...","private_key":"...","webhook_secret":"..."}
# Webhook URL: POST /v1/webhooks/github/<connection-slug>

# Pool bootstrap (optional)
# Unattended installs create the first organization owner at startup. All
# three required values must be set together; the temporary password needs at
# least 12 characters and must be changed on first sign-in. Never log or commit
# it, and only expose sign-in over TLS.
# TIDEBOOT_ORGANIZATION_NAME=Rock Pool
# TIDEBOOT_OWNER_EMAIL=owner@example.com
# TIDEBOOT_OWNER_PASSWORD=replace-me-with-12-plus
# TIDEBOOT_OWNER_NAME=Owner

# Logging (e.g. info, debug, tidepool=debug)
RUST_LOG=info
